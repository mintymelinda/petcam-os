[Unit]
Description=PetCam local RTSP server for OBS
Documentation=https://github.com/mintymelinda/petcam-os
After=network.target
Wants=network.target

[Service]
Type=simple
User=petcam
Group=petcam
ExecStart=/opt/petcam/current/bin/mediamtx /etc/petcam/mediamtx.yml
Restart=always
RestartSec=3
RuntimeDirectory=mediamtx
RuntimeDirectoryMode=0750
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadOnlyPaths=/etc/petcam/mediamtx.yml
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
LockPersonality=true
RestrictSUIDSGID=true

[Install]
WantedBy=multi-user.target

#!/bin/sh
set -eu

# This helper is the complete privilege boundary for the OBS RTSP service.
# Keep accepted actions explicit; never forward arbitrary caller arguments.
if [ "$(id -u)" -ne 0 ]; then
    echo "petcam-rtmp-service must be run as root" >&2
    exit 1
fi

if [ "$#" -ne 1 ]; then
    echo "Usage: petcam-rtmp-service {enable|disable|restart}" >&2
    exit 2
fi

case "$1" in
    enable)
        exec /usr/bin/systemctl enable --now petcam-rtmp.service
        ;;
    disable)
        exec /usr/bin/systemctl disable --now petcam-rtmp.service
        ;;
    restart)
        /usr/bin/systemctl enable petcam-rtmp.service
        exec /usr/bin/systemctl restart petcam-rtmp.service
        ;;
    *)
        echo "Unsupported petcam-rtmp-service action: $1" >&2
        exit 2
        ;;
esac
